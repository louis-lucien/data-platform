# Modèle de configuration. Copier ce fichier en ".env" puis changer les mots de passe.
# Le fichier .env est ignoré par Git : les secrets ne quittent jamais votre machine.

# --- PostgreSQL (sources opérationnelles + Data Warehouse) ---
POSTGRES_USER=platform
POSTGRES_PASSWORD=change_me
POSTGRES_DB=energy
DW_DB=warehouse

# --- MySQL (système de facturation / recharges) ---
MYSQL_USER=platform
MYSQL_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=billing

# --- MongoDB ---
MONGO_USER=platform
MONGO_PASSWORD=change_me

# --- Neo4j (format imposé : utilisateur/motdepasse) ---
NEO4J_AUTH=neo4j/change_me_neo4j

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC_READINGS=meter-readings
KAFKA_TOPIC_ALERTS=meter-alerts

# --- Générateur de flux : intervalle aléatoire entre deux événements (secondes) ---
STREAM_MIN_INTERVAL=3
STREAM_MAX_INTERVAL=10

# --- Chargeur (loader) : emplacement du data lake à charger dans les bases ---
# Dans Docker, ce chemin est fixé par le compose (/data/raw) ; hors Docker, le
# loader utilise data/raw par défaut. Décommentez pour forcer un autre chemin.
# DATA_ROOT=data/raw

# --- Airflow (profil "airflow") ---
# Le DockerOperator lance des conteneurs via le démon Docker de l'HÔTE : le bind
# mount du data lake doit donc pointer vers le chemin HÔTE (pas celui vu par
# Airflow). Par défaut ./data/raw ; mettez un chemin ABSOLU si le relatif échoue.
HOST_DATA_RAW=./data/raw
# Réseau Docker du projet (compose = "<dossier>_default"). À ajuster si le dossier
# racine n'est pas "data-platform".
COMPOSE_PROJECT_NETWORK=data-platform_default
