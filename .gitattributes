# Normalisation des fins de ligne.
# Par défaut, Git gère automatiquement les fins de ligne par fichier texte.
* text=auto

# Les scripts shell DOIVENT rester en LF, même clonés sur Windows : un .sh en
# CRLF casse à l'exécution dans un conteneur Linux ("bad interpreter").
*.sh   text eol=lf

# Idem pour les scripts joués dans les conteneurs Linux.
*.cql     text eol=lf
*.cypher  text eol=lf
Dockerfile text eol=lf
